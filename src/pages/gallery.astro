---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ImageLightbox from '@/components/ImageLightbox.astro';
import { galleryImages } from '@/data/site';
---

<BaseLayout title="Gallery" description="Portraits of Ulkar Aghayeva in Brooklyn." image={galleryImages[4][0]}>
  <main id="main" class="page-shell gallery-page">
    <header class="page-intro">
      <h1>Gallery</h1>
    </header>
    <div class="gallery-grid">
      {galleryImages.map(([src, alt], index) => (
        <button
          type="button"
          class:list={['gallery-image-trigger', { 'gallery-wide': index === 4 }]}
          data-lightbox-trigger
          aria-label={`Expand image: ${alt}`}
        >
          <img src={src} alt={alt} loading={index < 4 ? 'eager' : 'lazy'} />
        </button>
      ))}
    </div>
  </main>
  <ImageLightbox />
</BaseLayout>
