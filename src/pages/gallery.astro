---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { galleryImages } from '@/data/site';
---

<BaseLayout title="Gallery" description="Portraits of Ulkar Aghayeva in Brooklyn." image={galleryImages[4][0]}>
  <main id="main" class="page-shell gallery-page">
    <header class="page-intro">
      <p class="eyebrow">Portraits</p>
      <h1>Gallery</h1>
    </header>
    <div class="gallery-grid">
      {galleryImages.map(([src, alt], index) => (
        <a href={src} class:list={{ 'gallery-wide': index === 4 }} aria-label={`View full-size image: ${alt}`}>
          <img src={src} alt={alt} loading={index < 4 ? 'eager' : 'lazy'} />
        </a>
      ))}
    </div>
  </main>
</BaseLayout>
