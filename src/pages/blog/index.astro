---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, yearFromDate } from '@/data/site';

const posts = (await getCollection('blog')).sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const years = [...new Set(posts.map((post) => yearFromDate(post.data.date)))];
---

<BaseLayout title="Blog" description="Essays on music, listening, culture, language, and composition by Ulkar Aghayeva.">
  <main id="main" class="page-shell">
    <header class="page-intro page-intro--wide">
      <p class="eyebrow">Writing on music and culture</p>
      <h1>Blog</h1>
      <p>If you’d like to receive my writing on music in your inbox, you can do so via my Substack, <a href="https://ulkaraghayeva.substack.com/">The Bass Line</a>.</p>
    </header>
    <div class="blog-archive">
      {years.map((year) => (
        <section aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <ol>
            {posts.filter((post) => yearFromDate(post.data.date) === year).map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>
                  <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
                  <img src={post.data.featuredImage} alt="" loading="lazy" />
                  <span>{post.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </main>
</BaseLayout>
