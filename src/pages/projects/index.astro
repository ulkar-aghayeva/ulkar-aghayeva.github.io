---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, projectOrder } from '@/data/site';

const entries = await getCollection('projects');
const projects = projectOrder.map((id) => entries.find((entry) => entry.id === id)).filter(Boolean);
---

<BaseLayout title="Projects" description="Science writing, music history, piano recordings, interviews, and composition by Ulkar Aghayeva.">
  <main id="main" class="page-shell">
    <header class="page-intro page-intro--wide">
      <p class="eyebrow">Archive</p>
      <h1>Projects</h1>
      <p>Writing and listening across science history, metascience, performance, and composition.</p>
    </header>
    <ol class="project-index">
      {projects.map((project, index) => project && (
        <li>
          <a href={`/projects/${project.id}`}>
            <div class="project-index__meta"><span>0{index + 1}</span><time>{formatDate(project.data.date)}</time></div>
            <img src={project.data.featuredImage} alt="" loading="lazy" />
            <h2>{project.data.title}</h2>
            <p>{project.data.description || 'Read the complete project notes and listen to the recordings.'}</p>
          </a>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
