---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchiveEntry from '@/components/ArchiveEntry.astro';
import { formatDate, getPreviewDescription, sortProjects } from '@/data/site';

const entries = await getCollection('projects');
const projects = sortProjects(entries);
---

<BaseLayout title="Projects" description="Science writing, music history, piano recordings, interviews, and composition by Ulkar Aghayeva.">
  <main id="main" class="page-shell">
    <header class="page-intro page-intro--wide">
      <h1>Projects</h1>
      <p>Writing on science history, music criticism, and composition.</p>
    </header>
    <ol class="project-index">
      {projects.map((project, index) => (
        <li>
          <ArchiveEntry
            variant="project"
            href={`/projects/${project.id}`}
            title={project.data.title}
            date={project.data.date}
            formattedDate={formatDate(project.data.date)}
            image={project.data.featuredImage}
            description={getPreviewDescription(project.data, 'Call of the muse.')}
            number={String(index + 1).padStart(2, '0')}
          />
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>
