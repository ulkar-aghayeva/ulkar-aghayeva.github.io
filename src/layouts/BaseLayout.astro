---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ScrollScore from '@/components/ScrollScore.astro';
import '@fontsource/libre-baskerville/400.css';
import '@fontsource/libre-baskerville/400-italic.css';
import '@fontsource/libre-baskerville/700.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  home?: boolean;
  article?: boolean;
  publishedTime?: string;
}

const {
  title = 'Ulkar Aghayeva',
  description = 'Ulkar Aghayeva is a science writer and composer working across science history, metascience, and music.',
  image = '/images/imported/-DSC09696-068066780.jpg',
  home = false,
  article = false,
  publishedTime,
} = Astro.props;
const pageTitle = title === 'Ulkar Aghayeva' ? title : `${title} | Ulkar Aghayeva`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11100f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/jpeg" href="/images/imported/UA_music_inv-5f8f7c599.jpg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="Ulkar Aghayeva" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{pageTitle}</title>
  </head>
  <body class:list={{ 'home-page': home }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!home && <Header />}
    <slot />
    <Footer />
    <ScrollScore />
  </body>
</html>
