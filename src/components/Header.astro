---
import { nav } from '@/data/site';
const { pathname } = Astro.url;
const isCurrent = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Ulkar Aghayeva, home">
    <img src="/images/imported/UA_music_inv-5f8f7c599.jpg" alt="" width="48" height="36" />
    <span>Ulkar Aghayeva</span>
  </a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {nav.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>
  <details class="site-menu">
    <summary>Menu</summary>
    <nav aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </details>
</header>
